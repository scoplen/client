{
  "name": "@scoplen/terminal",
  "version": "0.1.0",
  "description": "A framework-agnostic binary terminal surface for Scoplen clients and web consoles.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "licenses"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/react.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-xterm-css.mjs",
    "pretypecheck": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/xterm": "6.0.0"
  }
}
